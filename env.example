# Atrium — environment configuration
#
# Copy this file to .env and fill in the values for your machine.
#   cp env.example .env
#
# Never commit .env. As you add features that need configuration, add the
# variables here too — a marker sets up your project from this file alone.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:Admin%40123@localhost:5432/atrium

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# Centre timezone. All opening hours, week boundaries and scheduled jobs are
# evaluated in this zone. Do not assume it equals the server's zone.
CENTRE_TIMEZONE=America/New_York

# ---------------------------------------------------------------------------
# Session and authentication
# ---------------------------------------------------------------------------
# Replace this before doing anything else.
SESSION_SECRET=atrium-dev-secret-2026-random-9x7k2m

# Starter administrator account, created by the migration.
SEED_ADMIN_EMAIL=admin@atrium.local
SEED_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------
# Email 
# ---------------------------------------------------------------------------
# Use any transport a marker can run locally: SMTP, Gmail over OAuth,
# MailHog, Mailpit. Add whatever variables your choice needs.
# MailHog defaults are shown as a starting point.
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=atrium@local.test
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@atrium.local

# ---------------------------------------------------------------------------
# Scheduled jobs — not yet implemented
# ---------------------------------------------------------------------------
# Both digests run at 00:00 in CENTRE_TIMEZONE, not in UTC and not in the
# server's local zone.
SCHEDULER_ENABLED=true

# ---------------------------------------------------------------------------
# Assistant
# ---------------------------------------------------------------------------
# Set ASSISTANT_PROVIDER=stub or ASSISTANT_USE_STUB=true for deterministic
# local/test behavior with no Ollama, internet access, or credentials.
ASSISTANT_PROVIDER=stub        
ASSISTANT_USE_STUB=true       
ASSISTANT_BASE_URL=https://ollama.com/
ASSISTANT_MODEL=llama3.2:3b
ASSISTANT_API_KEY= api_key
ASSISTANT_TIMEOUT_MS=20000
